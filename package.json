{
  "name": "slop",
  "version": "0.1.0",
  "description": "A linter for prose: flags stock LLM phrasing, with pluggable rule sets",
  "type": "module",
  "bin": {
    "slop": "./js/cli.mjs"
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "lint": "node js/cli.mjs check -r .",
    "build-rules": "node tools/build-rules.mjs",
    "serve": "python3 -m http.server 8000"
  },
  "files": [
    "js/",
    "rules/",
    "web/",
    "tests/"
  ],
  "license": "Apache-2.0"
}
