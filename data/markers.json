{
  "$comment": "Agent signatures, groomed by hand. tools/pr-markers.mjs proposes additions through a pull request; nothing is added automatically. `pattern` is matched against the attribution footer only, never the body.",
  "confirmed": [
    {
      "product": "Claude Code",
      "pattern": "claude code|co-?authored-by:\\s*claude",
      "added": "2026-09-02"
    },
    {
      "product": "OpenAI Codex",
      "pattern": "openai-codex|generated with codex|chatgpt\\.com/codex",
      "added": "2026-09-02"
    },
    {
      "product": "Cursor",
      "pattern": "cursor_agent|cursor_summary|generated with cursor",
      "added": "2026-09-02",
      "note": "sentinel comment, not the word \"cursor\": people mention the editor"
    },
    {
      "product": "GitHub Copilot",
      "pattern": "co-?authored-by:\\s*copilot|copilot-swe-agent",
      "added": "2026-09-02"
    },
    {
      "product": "Gemini / Jules",
      "pattern": "gemini-code-assist|jules\\.google|google-labs-jules|generated with gemini",
      "added": "2026-09-02"
    },
    {
      "product": "Devin",
      "pattern": "devin-ai-integration|app/devin",
      "added": "2026-09-02"
    },
    {
      "product": "Letta",
      "pattern": "generated with letta",
      "added": "2026-09-02"
    },
    {
      "product": "OpenHands",
      "pattern": "openhands|all-hands\\.dev",
      "added": "2026-09-02"
    },
    {
      "product": "Aider",
      "pattern": "aider\\.chat|co-?authored-by:\\s*aider",
      "added": "2026-09-02"
    }
  ],
  "$comment2": "Footers that are attribution-shaped but not an agent. Kept so discovery stops re-proposing them.",
  "rejected": [
    {
      "what": "brew bump",
      "pattern": "brew bump",
      "why": "Homebrew's release automation, not an agent"
    },
    {
      "what": "Railway",
      "pattern": "generated by .?railway",
      "why": "deploy platform footer"
    },
    {
      "what": "release-please",
